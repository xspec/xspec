#
# Test XQuery using BaseX, and skip testing other languages
#
SAXON_URL=https://github.com/Saxonica/Saxon-HE/raw/main/12/Java
SAXON_VERSION=12.10

# Restricts Ant testing to XQuery only; uses BaseX with both Ant and Bats
XQUERY_PROCESSOR=basex

# Restricts Bats testing to test cases with "XQuery" in the test case name
FILTER=XQuery
