<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:p="http://www.w3.org/ns/xproc" xmlns:s="x-urn:test:xproc:steplibrary"
    xmlns:x="http://www.jenitennison.com/xslt/xspec" xproc="library-load.xpl">

    <x:scenario label="Loading a file named text.123 to produce a text file">
        <x:call step="s:load-text"/>
        <x:expect port="xproc-result"
            label="works if a media-type mapping says .123 files are text">text</x:expect>
    </x:scenario>
</x:description>
