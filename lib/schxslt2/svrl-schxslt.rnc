default namespace svrl = "http://purl.oclc.org/dsdl/svrl"

include "svrl.rnc"

## Allow pseudo-phases such as '#ALL' to appear in the @phase
## attribute
div {
     svrl.schematron-output.attributes |=
     attribute title { string }?,
     attribute phase { token }?,
     attribute schemaVersion { string }?,
     attribute schematronEdition { string }?
}

## The element svrl:suppressed-rule reports rules that do not fire
## because the node in question was matched by a previous rule in the
## current pattern.
div {
     svrl.fired-rule &= schxslt.suppressed-rule?

     schxslt.suppressed-rule =
         element svrl:suppressed-rule {
             schxslt.suppressed-rule.attributes,
             schxslt.suppressed-rule.content
         }

     schxslt.suppressed-rule.attributes =
         svrl.fired-rule.attributes

     schxslt.suppressed-rule.content =
         svrl.fired-rule.content
}

## The elements svrl:skipped-assert and svrl:skipped-report report on
## assertions or reports that where skipped because their severity was
## below the severity threshold.
div {
    svrl.failed-assert &= schxslt.skipped-assert?
    svrl.successful-report &= schxslt.skipped-report?

     schxslt.skipped-assert =
         element svrl:skipped-assert {
             schxslt.skipped-assert.attributes,
             schxslt.skipped-assert.content
         }

     schxslt.skipped-assert.attributes =
         attribute severityThreshold { token },
         svrl.failed-assert.attributes

     schxslt.skipped-assert.content =
         empty

     schxslt.skipped-report =
         element svrl:skipped-report {
             schxslt.skipped-report.attributes,
             schxslt.skipped-report.content
         }

     schxslt.skipped-report.attributes =
         attribute severityThreshold { token },
         svrl.successful-report.attributes

     schxslt.skipped-report.content =
         empty

}

## Failed assertions and successful reports may refer to the containig
## rule, pattern, and group. They also my carry a @xml:lang attribute
## due to language fixup.
div {
     svrl.failed-assert.attributes &=
         schxslt._rulePatterGroupReference &
         attribute xml:lang { xsd:language }?
     svrl.successful-report.attributes &=
         schxslt._rulePatterGroupReference &
         attribute xml:lang { xsd:language }?

     schxslt._rulePatterGroupReference =
         attribute ruleId { xsd:NMTOKEN }?,
         (
             attribute patternId { xsd:NMTOKEN } | attribute groupId { xsd:NMTOKEN }
         )?
}

## The svrl:property-reference/svrl:text element is special. The
## xsl:copy-of may copy an attribute node that attaches to the
## svrl:text element.
div {
     svrl.property-reference.content |=
         element svrl:text {
             attribute * { string }*,
             svrl.text.content
         }
}
